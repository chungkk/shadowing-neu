{
  "expo": {
    "name": "Deutsch Shadowing",
    "slug": "deutsch-shadowing",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deutschshadowing",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.chungkk.deutschshadowing",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "6CH84XZG3T",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffedd6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chungkk.deutschshadowing"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
              "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
              "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
              "./node_modules/@expo-google-fonts/baloo-2/800ExtraBold/Baloo2_800ExtraBold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "Baloo 2",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/baloo-2/800ExtraBold/Baloo2_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff6e9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập ảnh để bạn chọn ảnh đại diện.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ứng dụng cần micro để bạn ghi âm giọng nói khi luyện shadowing.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-apple-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ứng dụng cần micro để bạn ghi âm giọng nói khi luyện shadowing.",
          "speechRecognitionPermission": "Ứng dụng nhận dạng giọng nói để tô sáng từng từ khi bạn nói theo câu mẫu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
