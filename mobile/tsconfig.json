{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@shared/*": ["../src/lib/*"],
      "@content/*": ["../src/content/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/lib/subtitles.ts",
    "../src/lib/dictation.ts",
    "../src/lib/youtube-id.ts",
    "../src/lib/phrase-match.ts",
    "../src/lib/review.ts",
    "../src/lib/srs.ts",
    "../src/lib/deck-study.ts",
    "../src/lib/laixe/rules.ts",
    "../src/lib/laixe/units.ts",
    "../src/lib/quiz/types.ts"
  ]
}
