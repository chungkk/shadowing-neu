# ---- Admin (bắt buộc để đăng bài) ----
# Đăng nhập ở /login bằng ADMIN_EMAIL + ADMIN_PASSWORD → tài khoản admin (tự tạo lần đầu).
# Không ai đăng ký được bằng email này. Admin có thể cấp quyền admin cho user khác ở /admin/users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên để ký cookie đăng nhập (tạo bằng: openssl rand -base64 32)
AUTH_SECRET=

# ---- Gửi email mã xác nhận khi đăng ký (bắt buộc trên server thật) ----
# Gmail: bật Xác minh 2 bước → tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
# SMTP_USER=ban@gmail.com
# SMTP_PASS=abcdefghijklmnop
# Dịch vụ khác (mặc định smtp.gmail.com:465):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="Deutsch Shadowing <ban@gmail.com>"
# Chưa cấu hình: máy dev in mã ra console; server production báo lỗi khi đăng ký.

# Đường dẫn file SQLite (mặc định: data/shadow.db)
# DATABASE_PATH=

# ---- Tạo phụ đề tự động cho file local (tuỳ chọn, API tương thích OpenAI Whisper) ----
# OpenAI
# TRANSCRIBE_API_KEY=sk-...
# TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1

# Hoặc Groq (nhanh, rẻ, có free tier)
# TRANSCRIBE_API_KEY=gsk_...
# TRANSCRIBE_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-large-v3

# Hoặc Whisper offline chạy trên chính server (không cần key, xem README)
# Speaches (faster-whisper, Docker):
# TRANSCRIBE_API_URL=http://localhost:8000/v1/audio/transcriptions
# TRANSCRIBE_MODEL=Systran/faster-whisper-small
# whisper.cpp server (chạy với --convert để nhận m4a/webm):
# TRANSCRIBE_API_URL=http://localhost:8080/inference

# ---- yt-dlp: dự phòng khi IP server bị YouTube chặn ("…kein Bot…") ----
# Image Docker đã cài sẵn yt-dlp + bgutil (PO token), không cần cấu hình gì thêm.
# Nếu vẫn bị chặn: thêm cookies của 1 tài khoản YouTube PHỤ (file Netscape cookies.txt, đặt trong volume /app/data)
# YTDLP_COOKIES=/app/data/youtube-cookies.txt
# Hoặc đi qua proxy (IP dân dụng):
# YTDLP_PROXY=socks5://user:pass@host:1080
# Nâng cao: YTDLP_PATH, YTDLP_JS_RUNTIMES (mặc định node), BGUTIL_SERVER_HOME, BGUTIL_BASE_URL

# ---- Dịch câu sang tiếng Việt (tuỳ chọn) ----
# Mặc định dùng Groq (chung key TRANSCRIBE_API_KEY ở trên), mô hình nhỏ cho rẻ:
# TRANSLATE_MODEL=openai/gpt-oss-20b
# ChatGPT làm dự phòng khi Groq lỗi / hết lượt:
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSLATE_MODEL=gpt-5-mini
# Mỗi câu chỉ dịch 1 lần — bản dịch lưu trong SQLite, dùng chung cho mọi người học.

# ---- Giọng đọc tiếng Đức trong app (giọng neural như người thật) ----
# Mặc định dùng OpenAI gpt-4o-mini-tts (chung OPENAI_API_KEY ở trên). Không có key → app dùng giọng có sẵn của máy.
# Giọng bản xứ Đức tự nhiên nhất + rẻ: Azure Speech (có key thì tự dùng Azure thay OpenAI)
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=germanywestcentral
# Đổi giọng (OpenAI: marin, cedar, coral… · Azure: de-DE-SeraphinaMultilingualNeural, de-DE-ConradNeural, de-DE-KatjaNeural…)
# TTS_VOICE=marin
# Mỗi câu chỉ tạo 1 lần — file mp3 lưu trong data/tts cạnh DB, dùng chung cho mọi người học.

# ---- Đăng nhập bằng Google / Apple (app iOS) ----
# Google: Web client ID (Google Cloud Console → Credentials) — app dùng nó để lấy ID token; nhiều ID cách nhau dấu phẩy
# GOOGLE_CLIENT_IDS=1234-abc.apps.googleusercontent.com
# Apple: bundle ID của app (mặc định com.chungkk.deutschshadowing)
# APPLE_CLIENT_IDS=com.chungkk.deutschshadowing
# Thu hồi Sign in with Apple khi người dùng xoá tài khoản (App Store yêu cầu) — khoá .p8 tạo ở Apple Developer → Keys
# APPLE_TEAM_ID=6CH84XZG3T
# APPLE_KEY_ID=ABC123DEFG
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
